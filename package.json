{
  "name": "dsh-convenience",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "description": "DSH 便捷工具：在中文设置页管理可信 IP 免登录规则，其他访问交给 DSH 官方鉴权。",
  "engines": {
    "node": ">=22",
    "dsh": "0.2.2-rc.3"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "src/*.js",
    "dist/client.js",
    "locale/*.json",
    "cordis.patch.yml",
    "README.txt"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "3.19.0",
    "esbuild": "0.25.12",
    "react": "18.3.1",
    "react-test-renderer": "18.3.1"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test test/*.test.js",
    "prepack": "npm run build"
  }
}
